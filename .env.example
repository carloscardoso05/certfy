# Copy to .env (local) or fill the Dokploy "Environment" tab.
# Values below are the defaults used by docker-compose.prod.yml.

# Image pulled by Dokploy (built and pushed outside the server).
# Defaults to latest when omitted.
# CERTFY_IMAGE=docker.io/carloscardoso05/certfy:latest

# Required
APP_HOST=
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Database (optional)
POSTGRES_USER=certfy
POSTGRES_DB=certfy
POOL_SIZE=10

# Object storage (optional)
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=certfy-templates

# Branding: defaults keep the Certfy identity. Set all of them to customize.
BRAND_NAME=Certfy
BRAND_THEME=certfy
BRAND_MARK=certfy
BRAND_FROM_EMAIL=no-reply@certfy.local

# Access mode. Defaults assume a domain behind Traefik with TLS.
# For a deployment without a domain (plain HTTP on the server IP), use:
#   FORCE_SSL=false
#   PHX_SCHEME=http
#   PHX_PORT=4000
FORCE_SSL=true
PHX_SCHEME=https
PHX_PORT=443
# Host port published by docker-compose.prod.yml.
APP_PORT=4000

# Certificate e-mails
CERTIFICATE_FROM_NAME=Certfy
CERTIFICATE_FROM_EMAIL=no-reply@certfy.local

# SMTP (optional; without SMTP_HOST the mailer stays local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=if_available

# Used once by Certfy.Release.seed()
CERTFY_ADMIN_EMAIL=admin@certfy.local
